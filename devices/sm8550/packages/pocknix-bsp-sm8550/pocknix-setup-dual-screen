#!/usr/bin/python3
"""One-time desktop-session layout for dual-screen boards (currently: Thor).

Places the secondary output below the primary (centered), makes the primary
the priority-1 output, and pins each touchscreen to its own output so taps
land on the screen being touched. No-op on every other board (no
POCKNIX_SECONDARY_CONNECTOR set).

Ported from armada's system_files/usr/libexec/armada/setup-dual-screen
(this fork's sibling project, same board/KWin stack) - see that file's
history for the original derivation. Launched from the Plasma Mobile
autostart entry (pocknix-setup-dual-screen.desktop), same timing
constraints as pocknix-desktop-rotate: needs the running KScreen daemon,
so it cannot run before the compositor is up.
"""
import glob
import json
import subprocess
import sys

DEVICE_CONF_PATHS = ("/usr/lib/pocknix/device.conf", "/etc/pocknix/device.conf")


def device_env():
    """Parse the POSIX-sh device.conf KEY=VALUE files without sourcing them.

    Both files are simple `KEY=value` / `KEY="value"` lines (see
    devices/README.md's runtime contract); a real shell isn't needed to read
    them and this avoids depending on a helper binary like armada's
    device-env. Later files win, matching the sourcing order everywhere else.
    """
    env = {}
    for path in DEVICE_CONF_PATHS:
        try:
            with open(path) as f:
                lines = f.readlines()
        except OSError:
            continue
        for line in lines:
            line = line.strip()
            if not line or line.startswith("#") or "=" not in line:
                continue
            key, _, value = line.partition("=")
            key = key.strip()
            if not key.startswith("POCKNIX_"):
                continue
            value = value.strip().strip('"').strip("'")
            env[key] = value
    return env


def logical_size(output):
    mode = next(
        (m for m in output.get("modes", [])
         if str(m.get("id")) == str(output.get("currentModeId"))),
        None,
    )
    if mode is None:
        return None
    width = mode["size"]["width"]
    height = mode["size"]["height"]
    # KScreen rotation flags: 2 (left) and 8 (right) swap the axes.
    if output.get("rotation") in (2, 8):
        width, height = height, width
    scale = output.get("scale") or 1
    return round(width / scale), round(height / scale)


def input_devices():
    """Map input device name -> (vendor, product, event node)."""
    devices = {}
    for sysdir in glob.glob("/sys/class/input/input*"):
        try:
            name = open(f"{sysdir}/name").read().strip()
            vendor = int(open(f"{sysdir}/id/vendor").read(), 16)
            product = int(open(f"{sysdir}/id/product").read(), 16)
            event = next(
                e.rsplit("/", 1)[-1] for e in glob.glob(f"{sysdir}/event*")
            )
        except (OSError, StopIteration, ValueError):
            continue
        devices[name] = (vendor, product, event)
    return devices


def pin_touchscreen(name, connector, devices):
    if not name or name not in devices:
        return
    vendor, product, event = devices[name]
    # Persisted mapping, applied by KWin when the device is added.
    subprocess.run(
        ["kwriteconfig6", "--file", "kcminputrc",
         "--group", "Libinput", "--group", str(vendor),
         "--group", str(product), "--group", name,
         "--key", "OutputName", connector],
        check=False,
    )
    # Live mapping for the current session.
    subprocess.run(
        ["gdbus", "call", "--session", "--dest", "org.kde.KWin",
         "--object-path", f"/org/kde/KWin/InputDevice/{event}",
         "--method", "org.freedesktop.DBus.Properties.Set",
         "org.kde.KWin.InputDevice", "outputName", f"<'{connector}'>"],
        check=False, capture_output=True,
    )


def main():
    env = device_env()
    primary = env.get("POCKNIX_PRIMARY_CONNECTOR")
    secondary = env.get("POCKNIX_SECONDARY_CONNECTOR")
    if not primary or not secondary:
        return 0  # single-screen board: nothing to do

    try:
        outputs = json.loads(subprocess.run(
            ["kscreen-doctor", "-o", "-j"],
            capture_output=True, text=True, check=True,
        ).stdout)["outputs"]
    except (subprocess.SubprocessError, json.JSONDecodeError, KeyError) as exc:
        print(f"pocknix-setup-dual-screen: kscreen-doctor query failed: {exc}",
              file=sys.stderr)
        return 1
    by_name = {o["name"]: o for o in outputs}
    if primary not in by_name or secondary not in by_name:
        print(f"pocknix-setup-dual-screen: outputs not found (have "
              f"{sorted(by_name)}, want {primary!r}/{secondary!r})",
              file=sys.stderr)
        return 1

    primary_size = logical_size(by_name[primary])
    secondary_size = logical_size(by_name[secondary])
    if primary_size is None or secondary_size is None:
        print("pocknix-setup-dual-screen: could not read output modes",
              file=sys.stderr)
        return 1
    x = max(0, round((primary_size[0] - secondary_size[0]) / 2))
    subprocess.run(
        ["kscreen-doctor",
         f"output.{primary}.priority.1",
         f"output.{secondary}.priority.2",
         f"output.{primary}.position.0,0",
         f"output.{secondary}.position.{x},{primary_size[1]}"],
        check=True,
    )

    devices = input_devices()
    pin_touchscreen(env.get("POCKNIX_PRIMARY_TOUCHSCREEN"), primary, devices)
    pin_touchscreen(env.get("POCKNIX_SECONDARY_TOUCHSCREEN"), secondary, devices)
    return 0


if __name__ == "__main__":
    sys.exit(main())
