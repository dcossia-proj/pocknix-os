// proton-cachyos-x86: registers the CachyOS Proton x86_64 build as a selectable compat tool.
// The internal name never changes, so bumps keep per-game selections working.
"compatibilitytools"
{
  "compat_tools"
  {
    "proton-cachyos-x86"
    {
      "install_path" "."
      "display_name" "Proton-CachyOS @VER@ (x86_64)"
      "from_oslist"  "windows"
      "to_oslist"    "linux"
    }
  }
}
