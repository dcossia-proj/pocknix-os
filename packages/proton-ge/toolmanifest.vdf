// proton-ge: replaces the tarball manifest. Drops require_tool_appid — the SLR container
// it names cannot be downloaded, and the failure is SILENT (Steam runs another Proton).
// commandline goes via /pocknix-proton so per-game FEX profiles apply.
"manifest"
{
  "version" "2"
  "commandline" "/pocknix-proton %verb%"
  "use_sessions" "1"
  "compatmanager_layer_name" "proton"
}
