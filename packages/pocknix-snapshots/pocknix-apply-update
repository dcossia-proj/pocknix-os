#!/bin/bash
# pocknix-apply-update — non-interactive system update behind the QAM "Update" button.
# The Pocknix Control backend launches this as a transient systemd unit (systemd-run,
# no --wait, so it escapes the Decky loader's namespace AND outlives the RPC). Progress
# lands in /run/pocknix/update-status.json (atomic tmp+mv; /run is tmpfs = clears on
# the reboot it may ask for) and the full pacman output in /var/log/pocknix-update.log.
# The snapshot hooks fire inside pacman as on any other update path.
set -uo pipefail

RUN=/run/pocknix
STATUS="${RUN}/update-status.json"
LOG=/var/log/pocknix-update.log

[ "$(id -u)" = 0 ] || { echo "pocknix-apply-update: needs root" >&2; exit 1; }
mkdir -p "${RUN}"
exec 9> "${RUN}/apply-update.lock"
flock -n 9 || { echo "pocknix-apply-update: an update is already running" >&2; exit 1; }

now() { date -u +%FT%TZ; }
started="$(now)"

write_status() {  # <state> <exit_code|null> <finished-json> <detail>
  local state="$1" rc="$2" fin="$3" detail="$4"
  local sid=null low=false kin=false rr=false
  if [ -f "${RUN}/last-transaction.json" ]; then
    sid="$(jq '.snapshot_id' "${RUN}/last-transaction.json")"
    low="$(jq '.low_space' "${RUN}/last-transaction.json")"
    kin="$(jq '.kernel_in_transaction' "${RUN}/last-transaction.json")"
  fi
  [ -f "${RUN}/reboot-required" ] && rr=true
  jq -n --arg state "${state}" --arg started "${started}" --arg log "${LOG}" --arg detail "${detail}" \
        --argjson rc "${rc}" --argjson fin "${fin}" --argjson sid "${sid}" \
        --argjson low "${low}" --argjson kin "${kin}" --argjson rr "${rr}" \
    '{schema:1, state:$state, started:$started, finished:$fin, exit_code:$rc,
      snapshot_id:$sid, kernel_changed:$kin, reboot_required:$rr,
      low_space:$low, detail:$detail, log:$log}' \
    > "${STATUS}.tmp" && mv "${STATUS}.tmp" "${STATUS}"
}

rm -f "${RUN}/last-transaction.json"   # else a no-op update would report the previous one
echo "=== pocknix-apply-update ${started} ===" >> "${LOG}"
write_status running null null ""

# -Syu, never -Sy alone (partial-upgrade breakage); tee: journal AND the log file
pacman -Syu --noconfirm 2>&1 | tee -a "${LOG}"
rc="${PIPESTATUS[0]}"

detail="$(tail -n 1 "${LOG}" | tr -d '\r')"
if [ "${rc}" = 0 ]; then
  write_status success 0 "\"$(now)\"" "${detail}"
else
  write_status failure "${rc}" "\"$(now)\"" "${detail}"
fi
exit "${rc}"
