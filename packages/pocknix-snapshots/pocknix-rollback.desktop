[Desktop Entry]
Type=Application
Name=Pocknix Rollback
Comment=Roll the system back to the snapshot taken before the last update
Exec=konsole -e /bin/bash -c "pkexec /usr/bin/pocknix-rollback; echo; read -rp 'Press Enter to close... '"
TryExec=/usr/bin/pocknix-rollback
Icon=document-revert
Terminal=false
Categories=System;
Keywords=rollback;snapshot;restore;undo;
